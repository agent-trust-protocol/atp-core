{
  "name": "atp-core",
  "version": "0.1.0",
  "description": "ATP Core monorepo: Agent Trust Protocol packages, conformance suites and examples",
  "author": {
    "name": "ATP Team",
    "email": "dev@agenttrustprotocol.com",
    "url": "https://agenttrustprotocol.com"
  },
  "private": true,
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "conformance": "node scripts/conformance.mjs",
    "conformance:did": "jest --runInBand --testPathPatterns \"(did-v2|did-pairwise|did-vectors|did|operations|resolver)\\.test\\.ts$\"",
    "conformance:sigs": "jest --runInBand --testPathPatterns \"(crypto-v2|crypto|verify-compat)\\.test\\.ts$\"",
    "conformance:policy": "jest --runInBand --testPathPatterns \"(policy-conformance|policy-evaluator-conformance)\\.test\\.ts$\"",
    "conformance:audit": "jest --runInBand --testPathPatterns \"(audit-conformance|trust-conformance|trust-scoring-conformance|trust)\\.test\\.ts$\"",
    "conformance:privacy": "jest --runInBand --testPathPatterns \"(zkp-conformance|selective-disclosure)\\.test\\.ts$\"",
    "vectors": "TSX_TSCONFIG_PATH=tsconfig.base.json tsx scripts/gen-did-atp-vectors.ts",
    "vectors:check": "TSX_TSCONFIG_PATH=tsconfig.base.json tsx scripts/gen-did-atp-vectors.ts --check",
    "test:integration": "echo 'No integration tests configured yet — see scripts/tests/' && exit 1",
    "test:e2e": "echo 'No e2e tests configured yet — see scripts/tests/' && exit 1",
    "type-check": "tsc --noEmit",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@^1.20.0 --output-file sbom.json --omit dev"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/post-quantum": "^0.6.1",
    "@scure/base": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.7.4",
    "bcryptjs": "^3.0.2",
    "did-jwt": "^7.4.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "ws": "^8.14.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "better-sqlite3": "^12.4.1",
    "eventemitter3": "5.0.1",
    "fast-check": "^3.23.2",
    "jest": "30.5.2",
    "jose": "6.2.15",
    "ts-jest": "29.4.15",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
