{
  "name": "atp-core",
  "version": "1.0.0",
  "description": "Agent Trust Protocol — core monorepo containing protocol packages, SDK, and services",
  "author": {
    "name": "ATP Team",
    "email": "dev@agenttrustprotocol.com",
    "url": "https://agenttrustprotocol.com"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "jest --testPathPatterns='packages/' --passWithNoTests",
    "test:coverage": "jest --testPathPatterns='packages/' --coverage",
    "test:integration": "echo 'No integration tests configured' && exit 0",
    "test:e2e": "echo 'No e2e tests configured' && exit 0",
    "lint": "eslint packages/ --max-warnings 99999",
    "lint:fix": "eslint packages/ --fix --max-warnings 99999",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/post-quantum": "^0.4.1",
    "@scure/base": "^1.1.0",
    "axios": "^1.6.0",
    "did-jwt": "^7.4.0",
    "ioredis": "^5.0.0",
    "ws": "^8.14.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
