{
  "name": "atp-ui-modern",
  "version": "0.1.0",
  "description": "Modern UI for Agent Trust Protocol using Next.js and shadcn/ui",
  "author": {
    "name": "ATP Team",
    "email": "dev@agenttrustprotocol.com",
    "url": "https://agenttrustprotocol.com"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 99999",
    "lint:fix": "next lint --fix --max-warnings 99999",
    "format:check": "echo 'No formatter configured'",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "conformance": "node scripts/conformance.mjs",
    "conformance:did": "jest --runInBand --testPathPattern \"(did-v2|did-pairwise|did|operations|resolver)\\.test\\.ts$\"",
    "conformance:sigs": "jest --runInBand --testPathPattern \"(crypto-v2|crypto|verify-compat)\\.test\\.ts$\"",
    "conformance:policy": "jest --runInBand --testPathPattern \"(policy-conformance|policy-evaluator-conformance)\\.test\\.ts$\"",
    "conformance:audit": "jest --runInBand --testPathPattern \"(audit-conformance|trust-conformance|trust-scoring-conformance|trust)\\.test\\.ts$\"",
    "conformance:privacy": "jest --runInBand --testPathPattern \"(zkp-conformance|selective-disclosure)\\.test\\.ts$\"",
    "test:integration": "echo 'No integration tests configured yet — see scripts/tests/' && exit 1",
    "test:e2e": "echo 'No e2e tests configured yet — see scripts/tests/' && exit 1",
    "type-check": "tsc --noEmit",
    "sbom": "npx --yes @cyclonedx/cyclonedx-npm@^1.20.0 --output-file sbom.json --omit dev"
  },
  "dependencies": {
    "@noble/ed25519": "^2.0.0",
    "@noble/post-quantum": "^0.4.1",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@scure/base": "^1.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^7.0.3",
    "axios": "^1.7.4",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "did-jwt": "^7.4.0",
    "ioredis": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "lucide-react": "^0.294.0",
    "next": "^14.0.0",
    "nodemailer": "^8.0.5",
    "pg": "^8.18.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.2.0",
    "resend": "^6.5.2",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.1",
    "ws": "^8.14.0",
    "@noble/post-quantum": "^0.6.1",
    "ioredis": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "better-sqlite3": "^12.4.1",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "fast-check": "^3.23.2",
    "jest": "^29.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.3.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
