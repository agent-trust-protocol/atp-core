# ─── ATP Core — root .env.example ─────────────────────────────────────────────
# This file covers the Next.js frontend (deployed on Vercel).
# Each backend service has its own .env.example in packages/<service>/.
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# In Vercel, set these under: Project → Settings → Environment Variables

# ── App ────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Auth (Better Auth) ─────────────────────────────────────────────────────────
# REQUIRED — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Database (Better Auth session store) ───────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://atp_user:changeme@localhost:5432/atp_ui

# ── Email (pick one provider) ──────────────────────────────────────────────────
# Resend (recommended)
RESEND_API_KEY=

# SendGrid (alternative)
# SENDGRID_API_KEY=

# SMTP (alternative)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@yourdomain.com

# ── Public ATP service URLs (sent to the browser) ──────────────────────────────
# Set these to your Railway service public URLs after deploying.
NEXT_PUBLIC_ATP_IDENTITY_URL=http://localhost:3001
NEXT_PUBLIC_ATP_PERMISSION_URL=http://localhost:3003
NEXT_PUBLIC_ATP_AUDIT_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=http://localhost:3000

# ── Server-side ATP service URLs (not exposed to browser) ──────────────────────
ATP_IDENTITY_URL=http://localhost:3001
ATP_CREDENTIALS_URL=http://localhost:3002
ATP_PERMISSIONS_URL=http://localhost:3003
ATP_AUDIT_URL=http://localhost:3005
ATP_GATEWAY_URL=http://localhost:3000
ATP_MONITORING_URL=http://localhost:3005
ATP_PAYMENTS_URL=http://localhost:3009

# ── CI/CD secrets (GitHub Actions — set in repo Settings → Secrets) ────────────
# RAILWAY_TOKEN   → railway.app/account/tokens
# (Vercel deployment is handled automatically by the GitHub integration)
