# ─── Next.js App (add these in Vercel dashboard) ──────────────────────────────

# Internal service URLs (point to your Railway service URLs after deploying)
ATP_API_URL=https://your-identity-service.railway.app
ATP_QUANTUM_URL=https://your-vc-service.railway.app

# Public URLs (visible in browser)
NEXT_PUBLIC_ATP_PERMISSION_URL=https://your-permission-service.railway.app
NEXT_PUBLIC_APP_DOMAIN=https://your-app.vercel.app
NEXT_PUBLIC_DEV_DOMAIN=https://your-app.vercel.app

# Auth (Supabase or your auth provider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Backend Services (add these per-service in Railway dashboard) ─────────────

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis (for rate limiting and session caching)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_SECRET=your-secret-key-min-32-chars

# Identity Service
IDENTITY_SERVICE_PORT=3001

# Permission Service
PERMISSION_SERVICE_PORT=3003

# Audit Logger
AUDIT_SERVICE_PORT=3004

# VC Service
VC_SERVICE_PORT=3005

# RPC Gateway
RPC_GATEWAY_PORT=3006

# Monitoring Service
MONITORING_SERVICE_PORT=3007

# ─── GitHub Actions Secrets (add in repo Settings → Secrets) ──────────────────
# VERCEL_TOKEN          → from vercel.com/account/tokens
# VERCEL_ORG_ID         → from vercel.com/account (or team settings)
# VERCEL_PROJECT_ID     → from vercel.com/<project>/settings
# RAILWAY_TOKEN         → from railway.app/account/tokens
