# ─── audit-logger environment variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.
# Values marked REQUIRED must be set or the service will refuse to start.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3005

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://atp_user:changeme@localhost:5432/atp_audit

# ── Encryption ─────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
# Used to encrypt sensitive fields in audit records at rest.
AUDIT_ENCRYPTION_KEY=

# ── IPFS (optional) ────────────────────────────────────────────────────────────
# When set, audit events are also pinned to IPFS for immutable off-chain storage.
# IPFS_URL=http://localhost:5001
