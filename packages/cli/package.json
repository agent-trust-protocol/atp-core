{
  "name": "@atpdeveloper/atp-cli",
  "version": "0.1.0",
  "description": "Agent Trust Protocol (ATP) in your terminal: guard Claude Code and Hermes tool calls with ATP profiles, manage a did:atp identity, and keep a signed local audit trail",
  "type": "module",
  "bin": {
    "atp": "bin/atp.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "atp",
    "agent-trust-protocol",
    "cli",
    "claude-code",
    "hermes",
    "hooks",
    "ai-agents",
    "did",
    "policy"
  ],
  "author": "ATP Development Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-trust-protocol/atp-core.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/agent-trust-protocol/atp-core/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/agent-trust-protocol/atp-core/issues"
  },
  "dependencies": {
    "atp-hermes-hook": "^0.1.0",
    "atp-profiles": "^3.0.0",
    "atp-sdk": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
