# ─── rpc-gateway environment variables ───────────────────────────────────────
# Copy this file to .env and fill in the values.
# All variables are optional — defaults are shown.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3000                     # HTTP port
HTTPS_PORT=3443               # HTTPS / mTLS port (only used when TLS_CONFIG_PATH is set)
WS_PORT=8081                  # WebSocket port

# ── mTLS (optional) ────────────────────────────────────────────────────────────
# When set, the gateway starts a second HTTPS server with mutual TLS enabled.
# Point to a JSON file containing { cert, key, ca, requestCert, rejectUnauthorized }.
# TLS_CONFIG_PATH=/etc/atp/tls/gateway.json
