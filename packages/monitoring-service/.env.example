# ─── monitoring-service environment variables ────────────────────────────────
# Copy this file to .env and fill in the values.
# All variables are optional — defaults are shown.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
ATP_MONITORING_PORT=3005

# ── Sibling service URLs ────────────────────────────────────────────────────────
# Used to poll health and collect metrics from other ATP services.
# Leave blank in development to run monitoring in standalone mode.
ATP_IDENTITY_URL=http://localhost:3001
ATP_CREDENTIALS_URL=http://localhost:3002
ATP_PERMISSIONS_URL=http://localhost:3003
ATP_AUDIT_URL=http://localhost:3005
ATP_GATEWAY_URL=http://localhost:3000

# ── Alerting (optional) ─────────────────────────────────────────────────────────
# POST webhook called when a high-severity alert is triggered.
# ATP_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
