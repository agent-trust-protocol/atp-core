{
  "name": "@atp/monitoring-service",
  "version": "0.1.0",
  "private": true,
  "description": "ATP™ Real-time Monitoring Service - Enterprise monitoring and alerting",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch & NODE_OPTIONS='--loader ts-node/esm' node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "clean": "rm -rf dist",
    "test:storage": "tsc -p tsconfig.storage-test.json && node --test test/storage.test.mjs"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.0",
    "helmet": "^7.0.0",
    "node-cron": "4.2.1",
    "sqlite3": "6.0.1",
    "ws": "^8.14.0",
    "zod": "^3.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jest": "30.0.0",
    "@types/node": "^18.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.0",
    "jest": "30.5.2",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "monitoring",
    "metrics",
    "alerting",
    "atp",
    "agent-trust-protocol",
    "enterprise"
  ],
  "author": "ATP™ Development Team",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.17.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
