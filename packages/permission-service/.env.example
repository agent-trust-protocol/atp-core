# ─── permission-service environment variables ─────────────────────────────────
# Copy this file to .env and fill in the values.
# Values marked REQUIRED must be set or the service will refuse to start.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3003

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://atp_user:changeme@localhost:5432/atp_permissions

# ── JWT ────────────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
JWT_SECRET=

# ── Redis cache ────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=            # leave blank if Redis has no auth
CACHE_TTL=300                 # seconds; default 5 minutes
