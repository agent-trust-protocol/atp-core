# ─── identity-service environment variables ───────────────────────────────────
# Copy this file to .env and fill in the values.
# Values marked REQUIRED must be set or the service will refuse to start.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3001

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://atp_user:changeme@localhost:5432/atp_identity

# ── Session (MFA flows) ────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -base64 32
SESSION_SECRET=

# ── External DID Resolution ────────────────────────────────────────────────────
# Optional. When set, non-ATP DIDs (did:web, did:ethr, etc.) are resolved via
# this universal resolver URL. Resolved documents are cached locally.
# Default: https://dev.uniresolver.io (development only — use a private instance in production)
# DID_UNIVERSAL_RESOLVER_URL=https://dev.uniresolver.io

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
