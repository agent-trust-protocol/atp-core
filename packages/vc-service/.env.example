# ─── vc-service environment variables ────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Values marked REQUIRED must be set or the service will refuse to start.

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | production | test
PORT=3002

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED
DATABASE_URL=postgresql://atp_user:changeme@localhost:5432/atp_credentials
