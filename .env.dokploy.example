# ─── Dokploy environment for the ATP backend stack ──────────────────────────
# Set these in the Dokploy UI (project → Environment), NOT in the repo.
# Generate each secret with:  openssl rand -base64 32
#
# Required secrets (the compose fails fast if any are missing):
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
SESSION_SECRET=change-me-min-32-chars
JWT_SECRET=change-me-min-32-chars        # must be identical for permission-service and rpc-gateway
AUDIT_ENCRYPTION_KEY=change-me-min-32-chars

# Public frontend origin used for CORS on every service, e.g. https://app.yourdomain.com
CORS_ORIGIN=https://app.example.com

# Optional / has sane defaults:
NODE_ENV=production
POSTGRES_USER=atp_user
POSTGRES_DB=atp_prod
ATP_ALERT_WEBHOOK_URL=          # monitoring-service alert webhook (optional)
