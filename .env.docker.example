# ─── docker compose local development ────────────────────────────────────────
# Copy this file to .env and fill in the values:
#   cp .env.docker.example .env
#
# Then start the stack:
#   docker compose up
#
# First-time DB setup runs automatically via the db-migrate service.

# ── Postgres ───────────────────────────────────────────────────────────────────
POSTGRES_USER=atp_user
POSTGRES_PASSWORD=             # REQUIRED — choose any strong password locally
POSTGRES_DB=atp_local

# ── Secrets ────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
SESSION_SECRET=                # REQUIRED — identity-service
JWT_SECRET=                    # REQUIRED — permission-service
AUDIT_ENCRYPTION_KEY=          # REQUIRED — audit-logger

# ── Optional overrides ─────────────────────────────────────────────────────────
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# IPFS_URL=http://ipfs:5001
# ATP_LOG_LEVEL=info
